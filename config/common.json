{
  "schema_version": "0.1.0",
  "provider": "github-copilot-cli",
  "agents": [
    "requirements",
    "correctness",
    "security",
    "testing",
    "maintainability",
    "performance",
    "operations",
    "devil_advocate",
    "final"
  ],
  "max_concurrent_copilot_processes": 1,
  "output": {
    "reports_dir": "reports",
    "runtime_dir": "runtime"
  },
  "repository_audit": {
    "profile": "standard",
    "max_batches": 30,
    "max_files": 1000,
    "max_total_lines": 100000,
    "max_copilot_calls": 150,
    "max_files_per_batch": 30,
    "max_lines_per_batch": 5000
  }
}
