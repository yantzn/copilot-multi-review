{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Copilotレビュー: 実行状況を表示",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "ai_review",
        "status"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "osx": {
        "command": "python3"
      },
      "linux": {
        "command": "python3"
      }
    }
  ]
}
