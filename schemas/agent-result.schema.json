{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResult",
  "type": "object",
  "required": ["run_id", "agent", "provider", "schema_version", "decision", "findings", "summary"],
  "properties": {
    "run_id": { "type": "string" },
    "agent": { "type": "string" },
    "provider": { "const": "github-copilot-cli" },
    "schema_version": { "type": "string" },
    "status": {
      "enum": ["completed", "inconclusive", "blocked", "failed"]
    },
    "decision": {
      "enum": ["APPROVE", "APPROVE_WITH_NOTES", "CHANGES_REQUIRED", "BLOCKED", "INCONCLUSIVE"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "message"],
        "properties": {
          "severity": { "enum": ["Critical", "Major", "Minor", "Info"] },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "category": { "type": ["string", "null"] },
          "range": { "type": ["string", "null"] },
          "line_range": { "type": ["string", "null"] },
          "rationale": { "type": ["string", "null"] },
          "recommendation": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] },
          "reported_by": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "reported_severities": {
            "type": ["array", "null"],
            "items": { "enum": ["Critical", "Major", "Minor", "Info"] }
          },
          "severity_conflict": { "type": ["boolean", "null"] }
        }
      }
    },
    "summary": { "type": "string" },
    "reviewer_states": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "string" }
    },
    "conflicts": {
      "type": ["array", "null"],
      "items": { "type": "object" }
    },
    "incomplete_review": { "type": ["boolean", "null"] }
  }
}
